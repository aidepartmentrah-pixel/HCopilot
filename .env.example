# .env.example — copy to .env and fill in real values before running
# `docker compose up`. Never commit the real .env file (see .gitignore).

# SQL Server container (leave DATABASE_PORT at 1433 unless it conflicts with
# another SQL Server instance already running on this host)
MSSQL_SA_PASSWORD=change-me-to-a-strong-password
DATABASE_NAME=hcopilot
DATABASE_USER=hcopilot_user
DATABASE_PASSWORD=change-me-to-a-strong-password
DATABASE_PORT=1433

# Host port mappings
BACKEND_PORT=8090
FRONTEND_PORT=8082
# New React frontend (frontend-new/) — runs in parallel with the old
# frontend above, same backend, additive only. See docs/development/New
# Frontend (React Rewrite)/0. Slicing Task Table.md.
FRONTEND_NEW_PORT=8083

# Encrypts the Hospital Directory API key at rest (ExternalApiSettings table).
# Generate a real key unique to THIS deployment — never reuse this
# placeholder, and never reuse one key across sites (a settings row copied
# from another site's DB backup won't decrypt with a different key):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

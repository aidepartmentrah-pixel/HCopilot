backend/datasets/*.csv

# Python byte-code and cache directories — never commit these
__pycache__/
*.pyc
*.pyo

# Local virtual environment and environment-specific secrets
backend/.venv/
.env
.env.*
!.env.example
!.env.offline.template

# Versioned Application Release artifacts (release/<version>/...) — built
# from source on demand via the release engineering scripts, include large
# Docker image tarballs, and are archived separately per the RAH Release
# Archive policy rather than committed to source control.
release/

# Packager output — fully generated, never hand-authored
/release_packager/
/.rah/

# Frontend E2E test tooling (Playwright) — dev/test-only, never part of the
# production image (see frontend/Dockerfile/nginx.conf, which serve the
# plain HTML/CSS/JS directly with no build step or node_modules).
frontend/node_modules/
frontend/playwright-report/
frontend/test-results/
frontend/tests/screenshots/

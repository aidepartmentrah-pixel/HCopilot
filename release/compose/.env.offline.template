# .env.offline.template — offline hospital server deployment
#
# Copy this file to .env in the release folder on the offline server and fill
# in real values. Never transfer a filled-in .env file back into version
# control or between hospitals — treat it as a secret.
#
# SHARED SQL SERVER INSTANCE: if this offline server already runs a SQL Server
# container for another RAH Lab project, do NOT start a second sqlserver
# service — instead:
#   1. Remove/comment out the `sqlserver` and `db-init` `build`/service blocks
#      you don't need (or just set DATABASE_SERVER below to that instance's
#      container name / host and keep db-init pointed at it).
#   2. Set DATABASE_SERVER to the existing instance's hostname or container name.
#   3. Make sure DATABASE_NAME below is unique to HCopilot so it doesn't
#      collide with another project's database on the same instance.

# !!! REPLACE BOTH PASSWORD VALUES BELOW BEFORE RUNNING install_offline.sh !!!
# Must be 8+ characters with at least 3 of: uppercase, lowercase, digit, symbol.
# install_offline.sh will refuse to run if either is left as the placeholder
# text or fails this complexity check — this is a confirmed real failure mode
# (see documentation/TROUBLESHOOTING.md, "dependency failed to start ...
# sqlserver ... is unhealthy").
MSSQL_SA_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DATABASE_NAME=HCopilotDB
DATABASE_USER=sa
DATABASE_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DATABASE_PORT=1433

BACKEND_PORT=8090
FRONTEND_PORT=8082

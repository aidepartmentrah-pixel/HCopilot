# frontend-new/.env — separate from the old frontend's own env files (§28).
# Copy to .env for local dev; not committed (see root .gitignore).

# Design decision (documented per §35): API calls use relative "/api/..."
# paths, same-origin, proxied to the backend — Vite's dev-server proxy
# below in dev, nginx's proxy_pass in production (frontend-new/nginx.conf,
# mirroring the old frontend's own frontend/nginx.conf pattern). This avoids
# baking a site-specific backend host/IP into the built JS bundle (Vite env
# vars are inlined at build time), which would otherwise force a distinct
# image build per hospital site. CORS being open on the backend was the
# original assumption for a direct cross-origin call; the proxy approach
# gets the same "zero backend changes" property without that constraint.
#
# VITE_API_BASE_URL stays available as an explicit escape hatch (e.g. local
# dev against a remote/staging backend without the proxy) — leave empty to
# use the default relative-path/proxy behavior.
VITE_API_BASE_URL=

# Only read by vite.config.ts's dev-server proxy (not inlined into the
# browser bundle) — where the dev proxy forwards /api requests to.
VITE_DEV_PROXY_TARGET=http://localhost:8090

VITE_APP_NAME=HCopilot

# Optional — shown in the Home dashboard's page header (Dashboard spec §3).
# Leave empty to omit it rather than showing a placeholder/fabricated name.
VITE_HOSPITAL_NAME=
